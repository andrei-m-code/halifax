<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Source debugging: Source Link + symbol package (build-time only, no runtime dependency) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>

        <Title>Halifax Service Foundation - Excel/CSV</Title>
        <Description>Halifax Service Foundation Excel/CSV Parsing library</Description>
        <Summary>Halifax Service Foundation Excel/CSV library</Summary>
        <Authors>andrei-m-code</Authors>

        <AssemblyVersion>6.4.0</AssemblyVersion>
        <FileVersion>6.4.0</FileVersion>
        <Version>6.4.0</Version>

        <RepositoryUrl>https://github.com/andrei-m-code/halifax</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageProjectUrl>https://github.com/andrei-m-code/halifax</PackageProjectUrl>
        <PackageId>Halifax.Excel</PackageId>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageDescription>Halifax Service Foundation Excel/CSV library</PackageDescription>
        <PackageTags>excel xlsx xls csv spreadsheet import export npoi service-foundation</PackageTags>

        <PackageReleaseNotes>
            v6.4.0 - CsvFile.ReadAsync reads raw CSV records (header first) with the same parser as ExcelConverter, for your own column mapping
            v6.3.0 - CsvFile.WriteAsync writes dictionary and dynamic rows (e.g. Dapper's) as CSV, byte for byte what CsvHelper's defaults wrote for dynamic records
            v6.2.0 - CSV is read and written by Halifax itself: CsvHelper is no longer a dependency (NPOI is the only one left). Same results as 6.1.0 for every input, pinned by tests. Microsoft.Build.Tasks.Git is no longer listed as a package dependency; Excel-specific package tags; documentation
            v6.1.0 - Own Excel reader replaces ExcelMapper and needs no SkiaSharp (a number read into a text property no longer fails); headers match case-insensitively; a bad cell throws ExcelConversionException naming the row and column. New ExcelWorkbookWriter for several sheets in one workbook, Exclude, ExcelCell.GetText, ExcelContentType constants and ReadExcel by sheet name. Dates are written as date cells. Writes leave the stream open and rewound. NPOI's unusable native SkiaSharp libraries (10.6 MB on linux-x64) no longer reach consumers
            v6.0.0 - First stable release, aligned with the Halifax 6 line. .NET 11 support, CSV moved to CsvHelper 34, package dependency updates
            v0.4.5 - Add Source Link and a symbol package (snupkg) for source-level debugging
            v0.4.4 - Package dependency updates
            v0.4.3 - Package dependency updates
            v0.4.2 - Package dependency updates, pin Microsoft.Build.Tasks.Git to patch transitive vulnerability
            v0.4.1 - Ship XML documentation in the package, enrich API docs, dependency updates
            v0.4.0 - Package dependency updates, pin System.Security.Cryptography.Xml to patch transitive vulnerability
            v0.3.2 - Package dependency updates, NPOI license acceptance
            v0.3.1 - Bug fixes, DateTime support, comprehensive tests
            v0.3.0 - Nullable reference types, trace warnings for conversion failures
            v0.2.x - .NET 10 support
            v0.1.x - .NET 9 support
            v0.x.x - Alpha release
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\Icon.png" Pack="true" PackagePath="Icon.png" />
        <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <!-- NPOI ships SkiaSharp without its managed DLL, but still copies the native libSkiaSharp for every
             platform (10.6 MB on linux-x64): dead weight that can never load. Halifax.Excel never needs
             SkiaSharp (see ExcelCell), so its consumers don't get those native files through it. -->
        <PackageReference Include="NPOI" Version="2.8.1" ExcludeAssets="native" />
        <!-- Pin patched version to resolve transitive vulnerability from NPOI (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf) -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
        <!-- Pin patched version to resolve transitive vulnerability from NPOI via Microsoft.SourceLink.GitHub 8.0.0 (GHSA-23fw-v26w-5fgq) -->
        <PackageReference Include="Microsoft.Build.Tasks.Git" Version="11.0.100" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    </ItemGroup>
</Project>
