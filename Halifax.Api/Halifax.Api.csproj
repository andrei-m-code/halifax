<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Source debugging: Source Link + symbol package (build-time only, no runtime dependency) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>

        <Title>Halifax Service Foundation - API</Title>
        <Description>Halifax Service Foundation API library</Description>
        <Summary>Halifax Service Foundation API library</Summary>
        <PackageDescription>Halifax Service Foundation API library</PackageDescription>
        <Authors>andrei-m-code</Authors>

        <AssemblyVersion>6.0.0</AssemblyVersion>
        <FileVersion>6.0.0</FileVersion>
        <Version>6.0.0</Version>

        <RepositoryUrl>https://github.com/andrei-m-code/halifax</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageProjectUrl>https://github.com/andrei-m-code/halifax</PackageProjectUrl>
        <PackageId>Halifax.Api</PackageId>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>api service-foundation services microservices serialization logging correlation-id base</PackageTags>

        <PackageReleaseNotes>
            v6.0.0 - .NET 11 support, package dependency updates (JwtBearer 11, Swashbuckle 11, Scalar 3, Halifax.Core 6.0.0)
v5.3.5 - Add Source Link and a symbol package (snupkg) for source-level debugging
            v5.3.4 - Package dependency updates
v5.3.3 - Package dependency updates
v5.3.2 - Package dependency updates
v5.3.1 - Ship XML documentation in the package, enrich API docs, dependency updates, Halifax.Core 5.2.1
v5.3.0 - Package dependency updates (Swashbuckle, Scalar, JwtBearer, Halifax.Core 5.2.0)
v5.2.3 - Package dependency updates
v5.2.2 - Update Halifax.Core to 5.1.2
v5.2.1 - Package dependency updates
v5.2.0 - Correlation ID middleware, structured version endpoint, nullable reference types
v5.0.x - .NET 10 support
v4.0.x - .NET 9 support
v3.2.x - Use global exception handler
v3.1.x - Minor improvements to the APIs
v3.0.x - .NET 8 support
v2.0.x - .NET 7 support. Improvements and bugfixes
v1.3.x - Configuration improvements
v1.3.5 - Claim extensions added
v1.3.x - Package version updates and minor improvements
v1.x.x - Stable version
v0.x.x - Initial release
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Halifax.Core" Version="6.0.0" />

        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
        <PackageReference Include="Scalar.AspNetCore" Version="3.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- <ProjectReference Include="..\Halifax.Core\Halifax.Core.csproj" /> -->
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Icon.png" Pack="true" PackagePath="Icon.png" />
        <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    </ItemGroup>
</Project>
