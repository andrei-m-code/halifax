<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Source debugging: Source Link + symbol package (build-time only, no runtime dependency) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        
        <Title>Halifax Service Foundation - Core</Title>
        <Description>Halifax Service Foundation Core library</Description>
        <Summary>Halifax Service Foundation Core library</Summary>
        <Authors>andrei-m-code</Authors>
        
        <AssemblyVersion>6.2.0</AssemblyVersion>
        <FileVersion>6.2.0</FileVersion>
        <Version>6.2.0</Version>
        
        <RepositoryUrl>https://github.com/andrei-m-code/halifax</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageProjectUrl>https://github.com/andrei-m-code/halifax</PackageProjectUrl>
        <PackageId>Halifax.Core</PackageId>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageDescription>Core Service Foundation library</PackageDescription>
        <PackageTags>api service-foundation services microservices serialization logging correlation-id base</PackageTags>

        <PackageReleaseNotes>
            v6.2.0 - Crypto: CryptoFormat.AesGcm (authenticated, randomized) chosen per call, Decrypt reads both formats, Encrypt(secret, text) output unchanged byte for byte, no more SYSLIB0060. Jwt: Read accepts tokens signed with the secret's ASCII or UTF-8 bytes (Jwt.GetSigningKeys); signing unchanged; no change at all for ASCII secrets. Env: bool, char, all integer types, enums, DateOnly, TimeOnly, DateTimeOffset, decimal and nullable properties bind; invariant-culture parsing; errors name the variable. ShortId: cryptographic random and thread-safe. CleanupDefaultLogging(level)
            v6.0.0 - .NET 11 support, package dependency updates (Microsoft.Extensions.Logging 11, Halifax.Domain 6.0.0)
v5.2.5 - Add Source Link and a symbol package (snupkg) for source-level debugging
            v5.2.4 - Package dependency updates
v5.2.3 - Package dependency updates
v5.2.2 - Package dependency updates
v5.2.1 - Ship XML documentation in the package, enrich API docs, dependency updates
v5.2.0 - Package dependency updates (Serilog, JWT, Microsoft.Extensions.Logging)
v5.1.3 - Package dependency updates
v5.1.2 - Update Halifax.Domain to 5.2.0
v5.1.1 - Package dependency updates
v5.1.0 - Nullable reference types, GeneratedRegex, generic ClaimIs&lt;T&gt;, collection expressions
v5.0.x - .NET 10 support
v4.0.x - .NET 9 support
v3.1.x - Minor improvements to the APIs
v3.0.x - .NET 8 support
v2.0.x - .NET 7 support. Improvements and bugfixes
v1.2.x - Logging improvements            
v1.1.5 - Claim extensions added
v1.1.x - Package version updates and minor improvements
v1.0.x - Stable version
v0.x.x - Initial release
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Halifax.Domain" Version="6.2.0" />

        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Destructurama.Attributed" Version="5.3.0" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Icon.png" Pack="true" PackagePath="Icon.png" />
        <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    </ItemGroup>
</Project>
